<Window x:Class="PasswordVault.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Secure Password Vault"
        Width="880"
        Height="640"
        MinWidth="740"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBackgroundBrush}" Padding="22,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Secure Password Vault"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#FFFFFF" />
                    <TextBlock Text="{Binding VaultPathText, StringFormat='Vault file: {0}'}"
                               FontSize="12"
                               Foreground="#94A3B8"
                               Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="12" Padding="12,5" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#B45309" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                                        <Setter Property="Background" Value="#15803D" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding LockBadgeText}"
                                       Foreground="#FFFFFF"
                                       FontWeight="SemiBold"
                                       FontSize="12.5" />
                            <TextBlock Text="{Binding IdleTimeRemainingText, StringFormat='  •  {0}'}"
                                       Foreground="#E2E8F0"
                                       FontSize="12.5"
                                       Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>

                    <Button Content="Lock Vault"
                            Click="LockVaultButton_Click"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body -->
        <Grid Grid.Row="1" Margin="22">
            <!-- Locked / Create or Unlock View -->
            <Border Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrushLight}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="28"
                    MaxWidth="460"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <StackPanel>
                    <!-- Create Vault Panel -->
                    <StackPanel Visibility="{Binding IsCreateMode, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Create Your Password Vault"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Choose a strong master passphrase (16-128 UTF-8 bytes). It derives your AES-256-GCM key via Argon2id and is never stored on disk."
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="13"
                                   Margin="0,6,0,18" />

                        <TextBlock Text="Master Passphrase" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <PasswordBox x:Name="CreatePassphraseBox"
                                     KeyDown="CreatePassphraseBox_KeyDown"
                                     Margin="0,0,0,14" />

                        <TextBlock Text="Confirm Master Passphrase" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <PasswordBox x:Name="ConfirmPassphraseBox"
                                     KeyDown="CreatePassphraseBox_KeyDown"
                                     Margin="0,0,0,20" />

                        <Button Content="Create &amp; Unlock Vault"
                                Click="CreateVaultButton_Click"
                                IsEnabled="{Binding IsNotBusy}"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>

                    <!-- Unlock Vault Panel -->
                    <StackPanel Visibility="{Binding IsUnlockMode, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Unlock Your Vault"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Enter your master passphrase to decrypt your saved entries."
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="13"
                                   Margin="0,6,0,18" />

                        <TextBlock Text="Master Passphrase" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <PasswordBox x:Name="UnlockPassphraseBox"
                                     KeyDown="UnlockPassphraseBox_KeyDown"
                                     Margin="0,0,0,20" />

                        <Button Content="Unlock Vault"
                                Click="UnlockVaultButton_Click"
                                IsEnabled="{Binding IsNotBusy}"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Unlocked View -->
            <Grid Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Add Entry Card -->
                <Border Grid.Row="0"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrushLight}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18">
                    <StackPanel>
                        <TextBlock Text="Add New Entry"
                                   FontSize="15.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Website" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,4" />
                                <TextBox Text="{Binding NewSite, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Username" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,4" />
                                <TextBox Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Password" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,4" />
                                <PasswordBox x:Name="EntryPasswordBox"
                                             KeyDown="EntryPasswordBox_KeyDown" />
                            </StackPanel>

                            <Button Grid.Column="6"
                                    Content="Add Entry"
                                    VerticalAlignment="Bottom"
                                    Click="AddEntryButton_Click"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Saved Entries Card -->
                <Border Grid.Row="2"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrushLight}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Saved Credentials"
                                   FontSize="15.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,12" />

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Entries}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E2E8F0"
                                  BorderBrush="{StaticResource BorderBrushLight}"
                                  BorderThickness="1"
                                  RowHeight="42"
                                  FontSize="13.5">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Website"
                                                    Binding="{Binding Site}"
                                                    Width="*" />
                                <DataGridTextColumn Header="Username"
                                                    Binding="{Binding Username}"
                                                    Width="*" />
                                <DataGridTextColumn Header="Password"
                                                    Binding="{Binding DisplayPassword}"
                                                    Width="*" />
                                <DataGridTemplateColumn Header="Actions" Width="210">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <Button Content="{Binding ToggleVisibilityText}"
                                                        Tag="{Binding}"
                                                        Click="ToggleRevealButton_Click"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Padding="10,4"
                                                        Margin="0,0,6,0" />
                                                <Button Content="Copy"
                                                        Tag="{Binding}"
                                                        Click="CopyButton_Click"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Padding="10,4"
                                                        Margin="0,0,6,0" />
                                                <Button Content="Delete"
                                                        Tag="{Binding}"
                                                        Click="DeleteButton_Click"
                                                        Style="{StaticResource DangerButtonStyle}"
                                                        Padding="10,4" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Padding="22,10" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="0,1,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#EFF6FF" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="Background" Value="#FEF2F2" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMessage}" FontSize="13" FontWeight="Medium">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#1E3A8A" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Foreground" Value="#991B1B" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </Grid>
</Window>
